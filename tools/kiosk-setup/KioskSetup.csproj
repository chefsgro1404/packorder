<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>setup-kiosk-printing</AssemblyName>
    <RootNamespace>KioskSetup</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Assembly metadata — visible in Windows file Properties > Details -->
    <AssemblyTitle>ShipScan Kiosk Print Setup</AssemblyTitle>
    <AssemblyDescription>Configures Chrome for silent label printing. Run once after installing the ShipScan PWA.</AssemblyDescription>
    <AssemblyCompany>ShipScan</AssemblyCompany>
    <AssemblyProduct>ShipScan</AssemblyProduct>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>ShipScan</Copyright>
  </PropertyGroup>
</Project>
